# Copy to secrets.env (git-ignored) and replace every value.
# Database password, used by Postgres and by the backend's DATABASE_URL.
POSTGRES_PASSWORD=change-me
# Fernet key for stored API keys:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me
# The first admin, created on startup.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too
# Prometheus scrapes /api/metrics with this bearer token (blank = metrics off).
METRICS_TOKEN=change-me-three
# Model providers (any can be blank).
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_API_KEY=
ANTHROPIC_API_KEY=
