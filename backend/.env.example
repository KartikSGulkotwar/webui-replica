# SQLite locally; Postgres in docker-compose / production
DATABASE_URL=sqlite:///./webui.db
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Comma-separated list of allowed CORS origins
FRONTEND_ORIGIN=http://localhost:5173
# Lock provider add/edit/delete (use on public deployments; there is no login)
PROVIDERS_READ_ONLY=false
# Messages per minute per client IP on /api/chat/stream (0 disables)
CHAT_RATE_LIMIT_PER_MINUTE=20
# Reverse proxies in front of the backend that append X-Forwarded-For
# (1 behind nginx/Render/Railway; 0 when clients connect directly)
TRUSTED_PROXY_HOPS=0
# Providers seeded on first startup (leave blank to skip)
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_API_KEY=
