# SQLite locally; Postgres in docker-compose / production.
# postgres:// and postgresql:// URLs (e.g. from Neon) are accepted as-is.
DATABASE_URL=sqlite:///./webui.db
# Apply migrations on startup. On Vercel set false: the build step migrates.
AUTO_MIGRATE=true
# Generate with: openssl rand -base64 32 | tr '+/' '-_'
ENCRYPTION_KEY=
# Comma-separated list of allowed CORS origins
FRONTEND_ORIGIN=http://localhost:5173
# Lock provider add/edit/delete (use on public deployments; there is no login)
PROVIDERS_READ_ONLY=false
# Each browser only sees its own conversations (public demos without login)
ISOLATE_CHATS_BY_BROWSER=false
# Model preselected for new visitors, e.g. groq:openai/gpt-oss-120b (blank = first)
DEFAULT_MODEL=
# Messages per minute per client IP on /api/chat/stream (0 disables)
CHAT_RATE_LIMIT_PER_MINUTE=20
# Reverse proxies in front of the backend that append X-Forwarded-For
# (1 behind nginx, Vercel, Render or Railway; 0 when clients connect directly)
TRUSTED_PROXY_HOPS=0
# Providers seeded on first startup (leave blank to skip)
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_API_KEY=
