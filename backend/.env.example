# SQLite locally; Postgres in docker-compose / production.
# postgres:// and postgresql:// URLs (e.g. from Neon) are accepted as-is.
DATABASE_URL=sqlite:///./webui.db
# Apply migrations on startup. On Vercel set false: the build step migrates.
AUTO_MIGRATE=true
# Generate with: openssl rand -base64 32 | tr '+/' '-_'
ENCRYPTION_KEY=
# Comma-separated list of allowed CORS origins
FRONTEND_ORIGIN=http://localhost:5173
# --- Accounts ---
# Signs session cookies. Blank: derived from ENCRYPTION_KEY.
SECRET_KEY=
SESSION_DAYS=7
# Initial values; admins can change these in the admin panel.
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=pending
# "Continue as guest" (public demos)
GUEST_ACCESS=false
# Create this admin on startup if missing (otherwise the first sign-up is admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
# Sign-up/login/guest attempts per minute per IP
AUTH_RATE_LIMIT_PER_MINUTE=10
# OAuth. Register <PUBLIC_URL>/api/auth/oauth/{github,google}/callback with the provider.
PUBLIC_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Built-in tools people may let models use (admins can change this in the admin panel)
ENABLED_TOOLS=calculator,current_time,fetch_url,web_search,add_memory
# Web search: duckduckgo (no key), searxng (+ base URL), brave or tavily (+ API key); blank = off
WEB_SEARCH_ENGINE=
WEB_SEARCH_BASE_URL=
WEB_SEARCH_API_KEY=
WEB_SEARCH_RESULT_COUNT=3
# Arena: two or more model IDs that answer blind side by side (admins can change it)
ARENA_MODELS=
# Model preselected for new visitors, e.g. groq:openai/gpt-oss-120b (blank = first)
DEFAULT_MODEL=
# Messages per minute per client IP on /api/chat/stream (0 disables)
CHAT_RATE_LIMIT_PER_MINUTE=20
# Reverse proxies in front of the backend that append X-Forwarded-For
# (1 behind nginx, Vercel, Render or Railway; 0 when clients connect directly)
TRUSTED_PROXY_HOPS=0
# Providers seeded on first startup (leave blank to skip)
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_API_KEY=
# Optional native Anthropic (Claude) provider seeded on first boot
ANTHROPIC_API_KEY=

# Documents (RAG). Upload limit in MB (use 4 on Vercel: it caps request bodies at 4.5 MB).
MAX_UPLOAD_MB=10
# Semantic search for documents: "" = keyword search only, "ollama", or "openai" (any /embeddings API).
# Admins can change these in Admin panel → Documents.
RAG_EMBEDDING_ENGINE=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_API_KEY=
