# SQLite locally; Postgres in docker-compose / production
DATABASE_URL=sqlite:///./webui.db
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Comma-separated list of allowed CORS origins
FRONTEND_ORIGIN=http://localhost:5173
# Lock provider add/edit/delete (use on public deployments; there is no login)
PROVIDERS_READ_ONLY=false
# Providers seeded on first startup (leave blank to skip)
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_API_KEY=
