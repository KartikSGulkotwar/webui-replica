# Read by docker-compose. Copy to .env and fill in.
# Generate with: openssl rand -base64 32 | tr '+/' '-_'
ENCRYPTION_KEY=
# Optional OpenAI-compatible provider seeded on first boot (Groq, OpenRouter, OpenAI, ...)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
# Optional native Anthropic (Claude) provider seeded on first boot
ANTHROPIC_API_KEY=

# Accounts. The first person to sign up becomes the admin, unless you set
# ADMIN_EMAIL + ADMIN_PASSWORD to create the admin on startup.
ENABLE_SIGNUP=true
# pending = new accounts wait for admin approval; user = can chat right away
DEFAULT_USER_ROLE=pending
# "Continue as guest" button (handy for public demos)
GUEST_ACCESS=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional "Sign in with GitHub/Google". Callback URL to register:
#   <PUBLIC_URL>/api/auth/oauth/github/callback (or /google/callback)
PUBLIC_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Host ports (change if something else already uses them)
FRONTEND_PORT=3000
BACKEND_PORT=8000
OLLAMA_PORT=11434
